#!/usr/bin/env bash
# Entrypoint for claude-box-redact: start the in-VM redaction proxy, prove it is
# actually intercepting, route Claude through it, then exec the run command.
#
# Fail closed: if the proxy does not come up or does not block a planted secret,
# Claude must not start. A session that reaches the API without the proxy is
# exactly the leak this box exists to prevent.
#
# The proxy loads the host-decrypted (plaintext) seed at /seed and writes the updated
# map to /capture, encrypted to the public key (touchless); both mounts come from
# `redact run`, and the box itself never decrypts.

set -u

LISTEN_HOST="127.0.0.1"
LISTEN_PORT="8788"
BASE_URL="http://${LISTEN_HOST}:${LISTEN_PORT}"
PROXY_LOG="/tmp/forge-redact.log"

forge-redact run --listen-host "${LISTEN_HOST}" --listen-port "${LISTEN_PORT}" >"${PROXY_LOG}" 2>&1 &
proxy_pid=$!

ca_path="$(forge-redact ca-path)"
listening=""
for _ in $(seq 1 100); do
    if [[ -f "${ca_path}" ]] \
        && kill -0 "${proxy_pid}" 2>/dev/null \
        && (exec 3<>"/dev/tcp/${LISTEN_HOST}/${LISTEN_PORT}") 2>/dev/null; then
        exec 3>&- 3<&-
        listening="yes"
        break
    fi
    sleep 0.2
done

if [[ -z "${listening}" ]]; then
    echo "redact-entry: redaction proxy failed to start; refusing to run unprotected" >&2
    cat "${PROXY_LOG}" >&2 2>/dev/null
    exit 1
fi

# A planted secret must be blocked (403) before any real session runs. This proves
# the proxy intercepts /v1/messages and the secret layer is live; the request is
# refused without ever reaching the upstream API.
probe_secret="sk-ant-AAAAAAAAAAAAAAAAAAAAAA"
status="$(curl -s -o /dev/null -w '%{http_code}' \
    -X POST "${BASE_URL}/v1/messages" \
    -H 'content-type: application/json' \
    --data "{\"model\":\"x\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"${probe_secret}\"}]}")"
if [[ "${status}" != "403" ]]; then
    echo "redact-entry: self-test expected 403 for a planted secret, got '${status}'; refusing to run" >&2
    cat "${PROXY_LOG}" >&2 2>/dev/null
    exit 1
fi

export ANTHROPIC_BASE_URL="${BASE_URL}"
export NODE_EXTRA_CA_CERTS="${ca_path}"

exec "$@"
