# forge-provision configuration — committed template.
# Copy to .env and edit values for this machine. .env is gitignored.
# Source: https://github.com/N4M3Z/forge-provision

# Your GitHub user/org. Used to construct clone URLs for own repos.
GITHUB_USER="your-github-user"

# Machine scope. Empty = full personal manifest; "work" = the corporate-laptop
# subset (manifests/Brewfile.work). Checked by scripts/install/brew-bundle.sh.
SCOPE=""

# Chezmoi dotfiles repo (owner/name or full URL) applied by
# scripts/configure/dotfiles.sh. Leave empty to skip dotfiles deployment.
DOTFILES_REPO=""

# Where reference repos and own siblings are cloned on this Mac.
DEV_DIR="${HOME}/Developer/${GITHUB_USER}"

# Old Mac mount path — only used by migration scripts when bringing state
# from a previous machine over a network volume. Leave empty otherwise.
OLD_MAC_MOUNT=""

# Convenience derivations — usually no need to override.
OLD_CLAUDE_DIR="${OLD_MAC_MOUNT}/.claude"
NEW_CLAUDE_DIR="${HOME}/.claude"

# Migration source root — the mounted home dir of the machine being migrated
# from (target-disk mode, Time Machine, or a NAS mirror). scripts/migrate/*
# default their SRC to a subpath under this; override per-run with positional
# args (`bash scripts/migrate/<app>.sh <SRC> <DST>`). Scripts skip gracefully
# when the source is not present. If this is a home-dir rsync that excluded
# hidden ~/Library files, ~/Library-based app config may need a separate
# targeted sync before the migrate scripts find it.
MIGRATE_SRC="/Volumes/old-mac"

# Voice data root (SuperWhisper, MacWhisper). Outside ~/Documents so the
# multi-GB models + recordings never touch iCloud Drive. Both apps point their
# storage here via their own settings. Default migration source is
# ${MIGRATE_SRC}/Data/Voice.
VOICE_DIR="${HOME}/Data/Voice"

# Terminal theme — exact name of a .terminal file in
# ${TERMINAL_SCHEMES_REPO}/terminal/ (see scripts/install/terminal-theme.sh).
# Pick from mbadolato/iTerm2-Color-Schemes (450+ themes; e.g. Dracula, Tomorrow Night,
# Solarized Dark, Catppuccin Mocha, Nord, Tokyo Night) or your own themes repo.
TERMINAL_THEME="Dracula"

# Where .terminal files live. Default = mbadolato/iTerm2-Color-Schemes (canonical, auto-cloned).
# Override to your own ${DEV_DIR}/themes for personal themes.
TERMINAL_SCHEMES_REPO="${DEV_DIR}/iTerm2-Color-Schemes"

# Git author identity — also used as the SSH key comment + git signing UID.
GIT_NAME="your-name"
GIT_EMAIL="your-email@example.com"

# YubiKey ed25519-sk key application identifier — distinguishes multiple resident keys.
SSH_YUBIKEY_APPLICATION="ssh:${GITHUB_USER}"

# Filename (under ~/.ssh/) for the YubiKey-resident SSH key handle.
# Convention: yubikey_<model>_<year_or_context>. Override per machine / per YubiKey.
SSH_KEY_NAME="yubikey_<model>_<year>"

# Domain for per-harness agent committer emails (<harness>@domain). Defaults
# to noreply.<hostname>.local so commits name the machine; local-only, so
# agent commits verify via allowed_signers but carry no GitHub Verified badge.
#AGENT_SIGNING_DOMAIN="noreply.<hostname>.local"
