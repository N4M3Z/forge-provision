# Dependencies for Zed's REPL kernels (scripts/configure/zed-repl-kernel.sh):
#   bash    — modern bash for the bash_kernel (macOS ships only 3.2; the kernel
#             spawns `bash` from PATH and needs >= 4 with readline).
#   zeromq  — libzmq, the native transport iruby (Ruby kernel) links against.
#   ruby    — Homebrew Ruby for iruby; system ruby 2.6 is too old to gem-install into.
brew "bash"
brew "zeromq"
brew "ruby"

# Ghostty — Zig+Swift terminal emulator, replaces Apple Terminal.app. Config
# at ~/.config/ghostty/config (managed via chezmoi). Reference:
# https://ghostty.org/docs/config
cask "ghostty"

# cmux — intentionally NOT installed via Homebrew. Reproduced on fresh
# Mac by `scripts/install/cmux.sh`, which curls the canonical-latest DMG
# from https://github.com/manaflow-ai/cmux/releases/latest/download/cmux-macos.dmg
# and drops cmux.app into /Applications. Rationale: cmux ships rapidly;
# we'd rather opt into upgrades manually than have `brew upgrade` overwrite
# a known-good version. The brew cask was uninstalled on 2026-05-21
# (see docs/journal/) after a brief detour.

# oMLX — intentionally NOT installed via Homebrew. Reproduced on fresh Mac by
# `scripts/install/omlx.sh`, which resolves the OS-matched .dmg from the GitHub
# releases API (https://github.com/jundot/omlx/releases) and drops oMLX.app into
# /Applications, symlinking the bundled omlx-cli to ~/.local/bin/omlx. The app is
# the daily-driver lane (PROV-0021); the formula `jundot/omlx/omlx` is the
# headless alternative, but both bind :8000 and share ~/.omlx/ — one at a time.

# crex (cmux-resurrect) — workspace snapshot save/restore for cmux. Saves
# tabs, pane layouts, CWDs, pinned state, startup commands, and auto-resumes
# Claude Code sessions via session IDs. Fills the gap tracked by cmux #2086
# (named session save/restore) until cmux ships native support.
tap "drolosoft/tap"
brew "drolosoft/tap/crex"

# Entire CLI (ARCH-0028) — AI-session checkpoint + resume. Captures full
# transcripts onto per-session entire/<hash> branches via Claude hooks,
# anchored to the commits they produced. Per-repo enablement with public-
# repo-safe flags is scripts/configure/entire.sh; usage in docs/tldrs/entire.md.
tap "entireio/tap"
cask "entire"

# Meslo LG Nerd Font — Powerline-glyph-patched Meslo. MesloLGS Nerd Font Mono
# variant is the p10k canonical face and what ghostty's font-family points at.
cask "font-meslo-lg-nerd-font"

# Atkinson Hyperlegible: high-legibility faces for Markdown. The Next
# proportional face renders Markdown preview body text; the Mono face backs the
# Markdown Focus editor profile. Code stays on MesloLGS Nerd Font Mono.
cask "font-atkinson-hyperlegible-next"
cask "font-atkinson-hyperlegible-mono"

# Google Chrome (Chromium browser). Safari is the default; Chrome stays for
# cross-browser dev/testing and sites that need Chromium quirks.
cask "google-chrome"

# Firefox (Gecko browser). Signs into Firefox Sync for the daily-driver profile;
# scripts/configure/firefox.sh hardens that profile from manifests/firefox/user.js
# once sync has populated it.
cask "firefox"

# Claude desktop app (Anthropic's native client). Already installed on this
# Mac; declaration closes the Brewfile gap so a fresh machine matches.
cask "claude"

# Obsidian (local-first markdown vault editor). Sibling to the "Obsidian Web
# Clipper" MAS entry, which captures pages into the vault. Vault location is
# chosen on first launch (typically ~/Developer or iCloud Drive).
cask "obsidian"

# SuperWhisper (dictation with LLM reformatting). Local Whisper model plus
# optional LLM post-processing for voice-to-text. Config and models migrate
# from the old Mac (~/Library/Application Support/superwhisper/).
cask "superwhisper"

# MacWhisper (speech recognition / transcription). Standalone Whisper-based
# transcription app. Config at ~/Library/Application Support/MacWhisper/.
cask "macwhisper"

# Thaw (menu bar manager). Hides overflow menu bar items behind a toggle.
# Open source. Reference: https://github.com/stonerl/Thaw/
cask "thaw"

# iStat Menus (system monitor in the menu bar). CPU, GPU, memory, disk,
# network, sensors and temperatures, and battery readouts. Paid one-time
# license; the cask installs the app and it self-updates. Sits beside Thaw,
# which manages the menu-bar density it adds. Reference:
# https://bjango.com/mac/istatmenus/
cask "istat-menus"

# btop (terminal resource monitor). TUI showing CPU, memory, disks, network,
# and per-process load; the in-terminal counterpart to iStat Menus' menu-bar
# readouts, runs inside Ghostty. Reference: https://github.com/aristocratos/btop
brew "btop"

# fd (find replacement, friendlier syntax, respects .gitignore by default).
brew "fd"

# Discord (official desktop app), contained by Little Snitch rather than
# replaced by a third-party client. The official app carries a more-hardened
# supply chain than a single-maintainer wrapper; its real cost (client
# telemetry, native modules, process scanning) is constrained at the network
# layer instead. See PROV-0011 and ARCH-0030. Reference: https://discord.com/
cask "discord"

# CLIProxyAPI — local gateway (127.0.0.1:8317) fronting the Claude, Codex, and
# Gemini subscription credentials with an OpenAI/Anthropic-compatible API, so
# every coding harness routes through one metered point. Config lives at
# $(brew --prefix)/etc/cliproxyapi.conf, managed by
# scripts/configure/cliproxyapi-usage.sh; account credentials in
# ~/.cli-proxy-api/. Spend is drained per harness key by CPA-Manager-Plus
# (scripts/install/cpa-manager-plus.sh). Tracks upstream deliberately — no pin.
# Reference: https://github.com/router-for-me/CLIProxyAPI
brew "cliproxyapi"

# CPA-Manager-Plus — persistence and dashboard layer for CLIProxyAPI's usage
# queue: drains per-request records into SQLite (~/.cpa-manager-plus/data/) and
# serves https://usage.internal on 127.0.0.1:18317. Formula in the personal tap
# (upstream ships binary releases only); the bin wrapper pins the working
# directory so the app finds its data beside ~/.cpa-manager-plus. Runs under
# `brew services`. Admin key and loopback bind converge via
# scripts/install/cpa-manager-plus.sh.
# Reference: https://github.com/seakee/CPA-Manager-Plus
brew "N4M3Z/tap/cpa-manager-plus"

# dnsmasq — resolver for the `*.internal` service names, listening on 127.0.0.1
# port 5354 (not 53, so it needs no root and cannot contend with anything else).
# /etc/resolver/internal scopes macOS to send only that suffix here, leaving
# system DNS — and therefore ProtonVPN and Tailscale resolution — untouched.
# One wildcard line covers every present and future service. Config fragment
# from manifests/dnsmasq/, deployed by scripts/configure/local-names.sh.
brew "dnsmasq"

# Caddy — reverse proxy terminating TLS on :443 for the `*.internal` names,
# routing by Host header to each service's loopback port so URLs carry no port.
# Binds *:443 unprivileged (macOS allows users the wildcard bind on low ports)
# and runs as a user LaunchAgent via `brew services start caddy`; the LAN face
# of that wildcard is closed by a Little Snitch inbound deny, verified by
# scripts/verify/local-names.sh. Serves mkcert certificates; backends stay
# plain HTTP on loopback.
# Caddyfile from manifests/caddy/, deployed by scripts/configure/local-names.sh.
brew "caddy"

# hostctl — /etc/hosts manager with named profiles, so a group of entries can be
# enabled or disabled as a unit instead of hand-editing. Not part of the
# `*.internal` naming stack (dnsmasq owns that); this is for the cases that need
# a static override — pinning a hostname during a migration, or bypassing DNS to
# test against a specific backend. Reference: https://guumaster.github.io/hostctl/
tap "guumaster/tap"
brew "guumaster/tap/hostctl"

# Little Snitch (outbound application firewall). Per-app, per-domain rules
# with wildcard matching, used to block Discord's telemetry endpoints while
# keeping the app functional. Needs the perpetual license, not Mini, and the
# system extension must be approved in System Settings after install.
# Reference: https://www.obdev.at/products/littlesnitch/
cask "little-snitch"

# NOT in Brewfile (official DMG, own auto-updater, same pattern as cmux +
# Claude Code): Parallels Desktop. See scripts/install/parallels.sh.
# Fallback if the official installer is unavailable: `brew install --cask parallels`

# Apple container: runs Linux containers in per-container lightweight VMs.
# This is the primary Linux-isolation tier for agents and disposable
# experiments, chosen for its own CLI (no Docker engine to install), the
# strongest boundary (one VM per container, not a shared kernel), and open
# source (Apache-2.0). Intentionally NOT in Brewfile: it requires macOS 26 +
# Apple Silicon, and `brew bundle` has no gate for that, so the install lives
# in scripts/install/container.sh behind version and architecture guards
# (along with the `container system start` bootstrap). Pairs with Parallels
# (untrusted macOS-app VMs) and the Claude Code Seatbelt sandbox (the harness
# tier).

# OrbStack: Docker-API-compatible container + Linux-VM runtime, kept alongside
# Apple container for convenience and ecosystem reach (Compose, Kubernetes,
# Docker tooling that Apple container's pre-1.0 CLI does not yet cover). Note
# it is the shared-kernel tier (containers share one VM), closed source, and
# paid for commercial use, so it is a DX convenience, not the isolation pick.
# Separate engine from Apple container; the two coexist without integration.
cask "orbstack"

# Apple container is deliberately absent from every manifest. It belongs solely
# to scripts/install/container.sh, which requires Apple Silicon and macOS 26 for
# container-to-container networking and then bootstraps the system service from
# the keg path. `brew bundle` applies no platform condition, so a manifest entry
# would attempt the formula on an Intel or older-macOS host and can fail the
# whole bundle instead of skipping cleanly.

# Zoom — external meetings with parties who are not on Proton Meet. Corporate
# reality on a work machine rather than a preference.
cask "zoom"
