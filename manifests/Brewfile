# forge-provision Brewfile — apps installed via Homebrew on this Mac.
# Apply with: brew bundle install --file=manifests/Brewfile
# Reference: https://github.com/Homebrew/homebrew-bundle

# Proton suite (the user is a Proton co-founder — defaults to Proton-native).
cask "proton-drive"
cask "proton-mail"
cask "proton-mail-bridge"
cask "proton-meet"
cask "proton-pass"
cask "protonvpn"

# Proton Pass CLI (official, in homebrew-core). Binary is `pass-cli`, the
# scriptable client for Proton Pass vaults, distinct from the proton-pass GUI
# cask above. Auth via browser handoff or a scoped personal access token for
# CI. See skills/PasswordToolkit/ProtonPass.md.
brew "proton-pass-cli"

# Proton Drive CLI (official `proton-drive`, notarized binary from Proton AG,
# Team ID 2SB5Z68H26). Not in homebrew-core and ships no source tarball, only a
# per-platform binary, so it is pinned by SHA-256 in a personal tap,
# github.com/N4M3Z/homebrew-tap. The `proton-drive` cask above is the GUI app;
# this installs the `proton-drive` CLI binary. Auth: `proton-drive auth login`.
tap "N4M3Z/tap"
brew "N4M3Z/tap/proton-drive-cli"

# Local LLM runner.
cask "lm-studio"

# CLIProxyAPI — fronts the CLI-based provider subscriptions (Claude, Codex,
# Gemini/Antigravity, Grok, Qwen) and re-exposes them as OpenAI-, Claude-,
# Gemini-, and Codex-compatible HTTP endpoints, so a harness points at one local
# base URL instead of carrying its own provider auth. Binary is `cliproxyapi`.
# Config path is compiled in at build time as /opt/homebrew/etc/cliproxyapi.conf
# (a copy of the project's config.example.yaml), default port 8317, provider
# tokens under ~/.cli-proxy-api. Runs as a launchd service via
# `brew services start cliproxyapi`. Provider logins are interactive OAuth
# (`cliproxyapi -<provider>-login`), so they stay outside provisioning.
brew "cliproxyapi"

# ollama and grok are deliberately absent. scripts/install/ollama.sh installs the
# ollama-app cask and then launches and health-checks the daemon, so a bare
# formula entry would add a second, divergent artifact. scripts/install/grok.sh
# installs xAI's CLI from x.ai/cli/install.sh; Homebrew's `grok` formula is an
# unrelated regular-expression utility that would take the same binary name.
# Both scripts also gate on `require_scope full`, keeping them off work machines.

# AI coding agent (CLI). Configured locally with lm-studio + Proton Lumo as providers.
# Config TBD — capture as scripts/configure/opencode.sh once provider files settle.
brew "opencode"

# Antigravity CLI (Google's terminal coding agent). An independent cross-reviewer
# alongside Claude Code and Codex. Config lives under ~/.gemini/; MCP servers are
# seeded from manifests/gemini/ by scripts/configure/gemini.sh. Auth is
# interactive: launch `agy` and sign in with a Google account. Google serves this
# to personal Google plans; the earlier gemini-cli does not. The cask auto-updates,
# so Homebrew does not pin its version.
cask "antigravity-cli"

# Antigravity (Google's agent-orchestration platform, the desktop app). Separate
# product from the `agy` CLI above and from the antigravity-ide editor. Shares the
# ~/.gemini/ config root and the same Google sign-in. Auto-updates, so Homebrew
# does not pin its version.
cask "antigravity"

# Codex (OpenAI's coding-agent CLI). Independent cross-reviewer of Claude Code's
# work via `codex exec review` in a read-only sandbox. Config deployed from
# manifests/codex/ by scripts/configure/codex.sh; auth is interactive (codex login).
cask "codex"

# Codex desktop app (official OpenAI, separate from the CLI). Adds Computer Use,
# which drives arbitrary macOS apps by seeing and clicking, gated behind macOS
# Screen Recording + Accessibility grants (TCC, granted manually in System
# Settings, not scriptable). Auto-updates itself, so Homebrew does not pin its
# version. Shares ~/.codex/config.toml with the CLI.
cask "codex-app"

# Modern rsync 3+ (Apple ships openrsync 2.6.9-compatible which lacks --info=progress2 etc).
# scripts/migrate/claude-history.sh requires this.
brew "rsync"

# Rust toolchain — required to build forge-cli from source.
# Alternative for end-users: download a prebuilt release from github.com/N4M3Z/forge-cli/releases.
brew "rust"

# uv — Python package/venv manager. Homebrew's pip3 enforces PEP 668, so Python
# tools install into isolated uv venvs instead. scripts/sandbox/claude-box builds
# the forge-redact PII-redaction wheel with `uv build` to bake into the redact box
# image. The MarkdownExtract skill's xlsx path (forge-text
# skills/MarkdownExtract/xlsx-extract) also relies on it: `uv run` resolves the
# script's inline PEP 723 openpyxl dependency on demand, with no shared venv.
brew "uv"

# ruff: Rust-based Python linter/formatter. Forge modules' prek pre-commit
# configs declare a `language: system` ruff hook, so the binary must be on PATH
# or the hook crashes on every commit (even in modules with no Python, where it
# resolves to a no-op). Installed standalone, not via uv, so the system hook
# resolves it.
brew "ruff"

# GitHub CLI — repo creation, ssh-key registration, gh auth.
brew "gh"

# gitui (Rust-based terminal UI for git). Replaces SourceTree for the day-to-day
# stage/commit/rebase/stash flow without leaving the terminal. Faster startup
# than lazygit, leaner feature surface. Vim-style keys; `?` shows the keymap.
# Preferred git TUI (bound to `space t g` in Zed); lazygit installed alongside.
brew "gitui"

# lazygit (Go terminal UI for git). Kept as the menu-driven alternative to gitui;
# also the closest analogue to lazyjj for muscle-memory parity across git and jj.
brew "lazygit"

# Git LFS (Large File Storage). Replaces large binaries in the working tree
# with lightweight pointer files; actual blobs live on the remote LFS store.
# Required for any repo that tracks media, ML weights, or other multi-MB
# binaries. After install, `git lfs install` wires the user-global hooks.
# Eventual successor: Git's native "large object promisers" feature (merged
# upstream in 2025 but not yet broadly deployed by GitHub/GitLab).
brew "git-lfs"

# Jujutsu (jj). Git-compatible VCS whose working copy is an auto-snapshotted
# commit, so there is no index to collide on across concurrent agent sessions.
# Used colocated (.git/ stays alongside .jj/), so gh, gitui, revdiff, tuicr, and
# Claude Code keep working; signing batches at push (sign-on-push), not per
# snapshot. Binary is `jj`. Decision: docs/decisions/ARCH-0032.
brew "jj"

# revdiff (Go-based terminal UI for AI-session diff review). Reads uncommitted
# changes / commit ranges / staged / single files. Inline annotations exported
# as structured stdout for piping back to Claude Code or OpenCode. The opencode
# plan-review integration is wired by scripts/configure/revdiff.sh.
tap "umputun/apps"
brew "umputun/apps/revdiff"

# tuicr (Rust Ratatui TUI for code review). Covers both local diff review
# (`tuicr -w` for working tree, `tuicr -r main..HEAD` for commit ranges)
# and GitHub PR review (`tuicr pr <num>` with `:submit` posting real PR
# review comments back). Clipboard export classifies comments as
# ISSUE/SUGGESTION/NOTE/PRAISE for AI-agent consumption. Pairs with the
# revdiff binary for local-only review; tuicr adds the GitHub PR posting
# layer revdiff doesn't have.
tap "agavra/tap"
brew "agavra/tap/tuicr"

# mdschema — markdown structure validator (frontmatter fields, heading rules,
# document structure) against .mdschema files. The MarkdownSchema skill wraps it;
# forge-lib lint.mk and the vault doctor (forge-obsidian) shell out to it.
tap "jackchuka/tap"
brew "jackchuka/tap/mdschema"

# Helix. Rust-native modal editor, batteries-included (LSP, fuzzy picker, multi-cursor
# built in, no plugin system). Selection-first model (verb after noun, unlike vim).
# Installed alongside Neovim for hands-on comparison; the lack of a plugin system
# means no render-markdown-style inline rendering, so pair with `glow` in a split.
brew "helix"

# Neovim. Modal editor with a deep plugin ecosystem. Paired with LazyVim distro
# (see scripts/configure/nvim.sh) plus render-markdown.nvim for Obsidian-style
# inline markdown rendering. The "notes for Claude to read" workflow lives here.
brew "neovim"

# glow. Rust+Go terminal markdown renderer by Charm. Used as a viewer in a tmux or
# zellij split next to Helix (which has no inline markdown rendering), and standalone
# for reading READMEs without leaving the terminal. `glow -p file.md` for pager mode.
brew "glow"

# yt-dlp — media downloader (youtube-dl successor, actively maintained). Pulls
# video/audio from YouTube and ~1800 other sites, with format selection,
# subtitle/chapter extraction, and SponsorBlock integration. Binary is `yt-dlp`.
brew "yt-dlp"

# ffmpeg — yt-dlp's required companion. YouTube serves video and audio as
# separate DASH streams above 720p; ffmpeg muxes them back together, and it
# also handles audio extraction (--extract-audio) and re-encoding. Without it,
# yt-dlp is capped at pre-merged formats. Also the general-purpose media
# swiss-army-knife (transcode, trim, concat) in its own right.
brew "ffmpeg"

# tealdeer — native Rust tldr client with first-class custom and patch pages.
# Forge pages extend upstream help with this machine's tool connections. It
# conflicts with tlrc and the Node client because each installs `tldr`.
brew "tealdeer"

# pandoc — universal markup converter. Reads/writes markdown, HTML, LaTeX,
# DOCX, EPUB, reST, org-mode, and ~30 more formats; the standard tool for
# turning a markdown document into a polished PDF or sharing notes with
# people who expect Word/Office formats. Pairs with typst (below) as the
# PDF engine.
brew "pandoc"

# typst — Rust-native typesetting system, a modern alternative to LaTeX.
# Fast incremental compilation, sane scripting language (not TeX macros),
# excellent Unicode and box-drawing glyph support (matters for ASCII-art
# diagrams and code listings). Used standalone for documents and as
# pandoc's `--pdf-engine` of choice — much faster than xelatex/lualatex,
# fewer Unicode footguns than pdflatex.
brew "typst"

# poppler — PDF utility suite (pdfinfo, pdftotext, pdftoppm, pdfimages).
# Used to inspect rendered PDFs (page count, metadata), extract text for
# diffing or grep, and rasterize pages to PNG. The de-facto open-source
# PDF toolkit on macOS.
brew "poppler"
# JSON munging — used by scripts/configure/claude-settings.sh to merge settings into ~/.claude/settings.json.
brew "jq"

# RTK (Rust Token Killer) — CLI proxy that compacts dev-tool output, 60–90% token savings.
# Wired into Claude Code via ~/.claude/hooks/rtk-rewrite.sh (see scripts/configure/rtk-hook.sh).
brew "rtk"

# GitLab CLI — sibling to gh for GitLab repos.
brew "glab"

# Wrangler (Cloudflare's CLI; formula name differs from the `wrangler` binary
# it installs). Workers, Pages, KV, R2, D1 from the terminal. Auth is
# interactive `wrangler login` (browser OAuth) or CLOUDFLARE_API_TOKEN for
# headless use; scripts/configure/cloudflare.sh checks both lanes.
brew "cloudflare-wrangler"

# Yubico Authenticator — modern GUI for FIDO2 / PIV / OATH / OpenPGP slot management.
# Replaces the discontinued yubico-yubikey-manager cask (disabled upstream 2025-07-27).
cask "yubico-authenticator"

# OpenSSH (brew's build) — bundled with FIDO2 security-key support (pulls libfido2 as a dep).
# macOS's /usr/bin/ssh* binaries know the ed25519-sk algorithm but lack the FIDO middleware,
# so scripts/install/ssh-yubikey-key.sh calls /opt/homebrew/bin/ssh-keygen explicitly.
brew "openssh"

# Native macOS ssh-askpass GUI — pops a Cocoa dialog for FIDO2 PIN entry. Without it,
# git commits signed via SSH hang waiting on a TTY prompt when run from non-interactive
# contexts (CI, agents, etc.). Configured via SSH_ASKPASS env var.
tap "theseal/ssh-askpass"
brew "theseal/ssh-askpass/ssh-askpass"

# GPG toolchain (GPG-0005): Homebrew gnupg over GPG Suite — current 2.5.x, one gpg
# on PATH, no paid GPGMail, no GPG Keychain, no MacGPG-vs-brew conflict over ~/.gnupg.
# pinentry-mac renders the PIN dialog; ykman sets OpenPGP touch policies and PINs.
# Installed by scripts/install/gpg-toolchain.sh. Decision: GPG-0001, GPG-0005.
brew "gnupg"
brew "pinentry-mac"
brew "ykman"

# pass — the Unix password-store, GPG-backed, distinct from the Proton Pass CLI
# above. pass-otp adds TOTP generation from stored secrets. Personal lane:
# scripts/install/pass.sh gates itself with `require_scope full`, and key custody
# ceremony tools stay off a managed machine.
brew "pass"
brew "pass-otp"

# Offline key-backup tooling (GPG-0006): paperkey strips an OpenPGP secret to the
# bytes not derivable from the public key; qrencode renders them OCR-free for paper.
# scripts/install/paperkey.sh.
brew "paperkey"
brew "qrencode"

# sq (Sequoia-PGP) — v6 / post-quantum OpenPGP. The only tool that reads Proton's
# post-quantum mail-key export; GnuPG cannot and structurally will not (GPG-0007).
# Pinned into the offline key vault's tools/ as the break-glass decryptor.
brew "sequoia-sq"

# gitleaks — pattern-based secret scanner. Catches AWS keys, tokens, PEM blocks,
# entropy-flagged strings in git history + working tree. Deterministic, fast, runs
# locally (no LLM). Pairs with deeper LLM-based scans via the SecretScan skill.
brew "gitleaks"

# prek, shellcheck, and semgrep back the commit-time validation chain. The
# repo's .pre-commit-config.yaml declares shellcheck and semgrep as
# `language: system` hooks, so pre-commit never installs them and a missing
# binary fails the hook. prek is the runner .githooks/pre-commit prefers before
# falling back to forge or a downloaded validate.sh.
brew "prek"
brew "shellcheck"
brew "semgrep"

# GitHub Desktop — GUI client.
cask "github"

# Dotfiles engine (ARCH-0005). Manages canonical source at ~/Developer/N4M3Z/dotfiles/
# with copy-or-symlink laydown into $HOME plus templating for per-machine variance.
brew "chezmoi"

# Shell prompt (ARCH-0007). Rust binary, cross-shell, overrides Prezto's prompt module.
# Active theme is the official tokyo-night preset (powerline two-line layout).
brew "starship"

# Shell history with SQLite backend (ARCH-0007). Replaces zsh-history-substring-search:
# search_mode_shell_up_key_binding="fulltext" gives substring-on-Up against atuin.
brew "atuin"

# zoxide — smarter cd, frecency-ranked directory jumper. Replaces enhancd.
# Loaded via the dotzsh-contrib zoxide module (`'zoxide'` in zpreztorc's
# pmodule list). Adds `z <query>` for top-match jump and `zi <query>` for
# fzf picker. cd stays the zsh builtin. Coexists with atuin (history).
brew "zoxide"

# ─── Prose, spec, and artifact gates (deck DECK-0010) ───────────────────────
# The declared-world lint row. Each tool is a single binary, runs locally,
# and backs a guarded prek hook in the runedeck repositories.

# prek — pre-commit-compatible hook runner (Rust). Executes the universal
# .pre-commit-config.yaml in every scaffolded repository.
brew "prek"

# rumdl — markdownlint-compatible markdown linter (Rust). MD013/MD025/MD041
# are off in repo configs because frontmatter carries the title.
brew "rumdl"

# lychee — link checker (Rust). Offline mode with fragment checks gates
# relative links; online sweeps stay scheduled CI jobs.
brew "lychee"

# typos — source-aware spell checker (Rust). Repo typos.toml excludes key
# material, provenance sidecars, and vendored style packages.
brew "typos-cli"

# vale — prose style engine (Go). Runs the STE style plus the vendored
# Deslop package for machine-writing tells.
brew "vale"

# zizmor — GitHub Actions security auditor (Rust). Pairs with actionlint.
brew "zizmor"

# actionlint — GitHub Actions schema and shell linter (Go).
brew "actionlint"

# d2 — declarative diagram DSL (Go). Readable source agents can edit,
# SVG at build time, ASCII output for tmux review. Mermaid stays only
# where GitHub renders it natively.
brew "d2"

# svgbob — hand-drawn ASCII art to SVG (Rust). Renders legacy ASCII
# diagrams as-is; new schematics use d2. Installed, not wired.
brew "svgbob"

# flameshot — screenshot annotation with a scriptable CLI. Installed, not
# wired; macOS native capture plus a fixed screencapture location covers
# the interactive flow today.
brew "flameshot"

# ─── Stack tools present on the machine but absent from the manifest ────────
