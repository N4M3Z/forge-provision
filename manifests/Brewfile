# the artifact pipeline.
tap "runedeck/tap"
brew "runedeck/tap/rune"

# ast-grep — structural code search. Named by the UseEfficientCLI rule: a
# structural match returns fewer results than a regex over code.
brew "ast-grep"

# semgrep — OWASP static analysis. The prek pre-push hook in every
# scaffolded repository runs it.
brew "semgrep"

# copier — template engine behind the skeleton. Consumers receive ceremony
# updates through `copier update`, never hand-copies.
brew "copier"

# tmux — terminal multiplexer. The review entry point (statusline segments,
# turn review picker, popups) lives on it.
brew "tmux"

# git-delta — syntax-highlighting diff pager for terminal review.
brew "git-delta"

# git-filter-repo — history rewrite tool for the coordinated authorship
# rewrite and future surgical rewrites.
brew "git-filter-repo"

# hyperfine — command benchmarking with statistical rigor.
brew "hyperfine"

# alerter — macOS notification CLI with actions. The signing summons and
# attention flows post through it.
tap "vjeantet/tap"
brew "vjeantet/tap/alerter"

# cmux-resurrect — session restore for cmux.
tap "drolosoft/tap"
brew "drolosoft/tap/cmux-resurrect"

# herdr — agent multiplexer: a tmux-class terminal that tracks whether each
# coding agent is working, blocked, done, or idle, with a socket API and a
# JSON CLI for scripted control. Supports the full local roster (Claude
# Code, Codex, OpenCode, pi, Grok, Antigravity).
brew "herdr"

# miller (binary: mlr) — awk for structured data: named-field operations over
# CSV, TSV, and JSON. The house rule sends YAML and JSON parsing to yq and jq;
# miller covers the tabular cases those two handle poorly.
brew "miller"

# sd — intuitive find-and-replace, the Rust sed alternative. The earlier name
# collision with the personal script dispatcher (PROV-0024) is resolved: the
# dispatcher migrates to just recipes, and the sd name belongs to this tool.
brew "sd"

# just — command runner, the modern make successor: recipes without build
# semantics, dotenv loading, and modules. The target of the script-dispatcher
# migration that supersedes PROV-0024's `sd` command.
brew "just"

# difftastic (binary: difft) — structural diff: parses code with tree-sitter
# and diffs syntax trees, so reformatting and moved blocks stop drowning the
# real change. On-demand second opinion beside delta: `jj diff --tool difft`.
brew "difftastic"

# watchexec — run a command on file change. The local watch primitive: D2
# render on save, lint on save outside harnesses, serve-and-watch shims.
brew "watchexec"

# jless — JSON and YAML pager TUI. The reading half of the data stack: rudof
# JSON reports, bench matrices, and herdr CLI output without jq sculpting.
brew "jless"

# taplo — TOML linter and formatter for the growing TOML fleet (dcg, typos,
# rumdl, codex configs). Guarded prek hook candidate beside check-yaml.
brew "taplo"

# shfmt — shell formatter beside shellcheck: shellcheck finds bugs, shfmt
# stops style drift across the hook and script surface.
brew "shfmt"

# direnv — per-directory environment loader. Wired into zsh via
# `eval "$(direnv hook zsh)"` in the shell rc. A directory's .envrc loads on
# entry and unloads on exit. The offline key vault ships an .envrc
# (`PATH_add tools/bin`) so its pinned restore tools land on PATH only while the
# shell is inside the mounted vault; direnv's allow-gate also stops a mounted
# volume's .envrc from auto-running until `direnv allow`. Decision: GPG-0006.
brew "direnv"

# fzf — interactive fuzzy finder. Backs zoxide's `zi` picker; also useful
# for vim plugins, git tools, completion menus.
brew "fzf"

# television — fuzzy finder TUI with preview channels. Backs Zed's cmd-p
# file-picker task (`tv files`, opened via zed-open). Decision: PROV-0024.
brew "television"

# bat — syntax-highlighting cat. Television's default previewer; also a
# general pager-friendly file viewer.
brew "bat"

# tmux — terminal multiplexer. The chezmoi-managed dot_config/tmux configures it
# and clones its plugins (resurrect, continuum, cpu, extrakto, fingers,
# catppuccin), and sesh plus tmux-fingers below extend it, so the multiplexer
# they all depend on belongs in the manifest rather than arriving incidentally.
brew "tmux"

# sesh — tmux session manager with zoxide integration and fzf picker.
# Standalone Go binary, not a TPM plugin. Replaces ad-hoc sessionizer scripts.
brew "sesh"

# tmux-fingers — hint-based copy overlay (prefix+F in tmux). The tmux plugin
# (chezmoi external) only wires bindings; the Crystal binary comes from brew,
# so fresh machines never see the plugin's install-wizard popup.
tap "morantron/tmux-fingers"
brew "morantron/tmux-fingers/tmux-fingers"

